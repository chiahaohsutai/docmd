{
  "name": "docmd",
  "version": "1.0.0",
  "description": "Document parsing using multimodal models",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/app.js",
    "fmt": "npx @biomejs/biome format --write ./src",
    "lint": "npx @biomejs/biome lint --write ./src",
    "dev": "nodemon --watch \"*.ts\" --exec \"ts-node\" ./src/app.ts",
    "check": "npx @biomejs/biome check --write ./src",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Chia Hao Hsu Tai",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.70",
    "dommatrix": "^0.1.1",
    "express": "^5.1.0",
    "pdfjs-dist": "^5.2.133",
    "unpdf": "^1.0.2",
    "zod": "^3.24.3",
    "zod-validation-error": "^3.4.0"
  }
}
