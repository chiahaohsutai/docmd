{
  "name": "docmd",
  "version": "1.0.0",
  "description": "PDF parsing using multimodal models",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/app.js",
    "fmt": "npx @biomejs/biome format --write ./src && npx @biomejs/biome format --write ./test",
    "lint": "npx @biomejs/biome lint --write ./src && npx @biomejs/biome lint --write ./test",
    "dev": "nodemon --watch \"*.ts\" --exec \"ts-node\" ./src/app.ts",
    "check": "npx @biomejs/biome check --write ./src && npx @biomejs/biome check --write ./test",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "author": "Chia Hao Hsu Tai",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.70",
    "dommatrix": "^0.1.1",
    "express": "^5.1.0",
    "nanoid": "^5.1.5",
    "ollama": "^0.5.15",
    "pdfjs-dist": "^5.2.133",
    "unpdf": "^1.0.2",
    "zod": "^3.24.3",
    "zod-validation-error": "^3.4.0"
  }
}
